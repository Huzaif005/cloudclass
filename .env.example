# ============================================================================
# CLOUDCLASS AWS ENVIRONMENT CONFIGURATION
# ============================================================================

# Server Port & Environment
PORT=8000
NODE_ENV=production

# JWT Authentication Secret
JWT_SECRET=cloudclass-aws-secure-secret-token-key-2026-change-in-production

# AWS S3 Storage Configuration
# (Can be omitted if deploying on AWS EC2/ECS with IAM Instance Profile)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=cloudclass-assignment-submissions

# Database Configuration (Optional for AWS RDS Oracle / PostgreSQL integration)
# DB_HOST=cloudclass-db.xxxx.us-east-1.rds.amazonaws.com
# DB_PORT=1521
# DB_NAME=ORCL
# DB_USER=cloudclass_admin
# DB_PASSWORD=your_secure_db_password
